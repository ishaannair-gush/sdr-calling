# JustCall (shared by all three workflows)
JUSTCALL_API_KEY=
JUSTCALL_API_SECRET=

# Lead Estimator target campaign (SalesDialer)
JUSTCALL_CAMPAIGN_ID=3309032

# Google Sheets (no-booking nurture sync)
GOOGLE_SHEETS_ID=
# Service-account JSON content (single line). Used directly by the node scripts
# and written to lead-estimator/credentials.json + no-booking/google-credentials.json
# by entrypoint.sh at boot.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CREDENTIALS_JSON=

# Postgres (lead estimator; the node scripts have their own hardcoded config)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Lead Estimator enrichment providers
APOLLO_API_KEY=
LEADMAGIC_API_KEY=
FULLENRICH_API_KEY=
AI_ARK_API_KEY=

PORT=3000
